# Copy this file to .env and fill in your own values.
# NEVER commit .env to GitHub (it is listed in .gitignore).

# "development" on your laptop, "production" when deployed
NODE_ENV=development

# Port the Express API listens on
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=workforce_management

# Used to sign the session cookie. Make it long and random, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# The React (Vite) app's address. Only this origin may call the API with cookies.
# Several origins can be separated by commas. Open the app with the SAME host
# name as here (localhost vs 127.0.0.1 count as different sites for cookies).
CLIENT_URL=http://localhost:5173
