{
  "name": "workforce-management-backend",
  "version": "1.0.0",
  "description": "REST API for the Workforce Management System (Express + MySQL)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test-db": "node config/testConnection.js",
    "create-admin": "node scripts/createAdmin.js",
    "migrate": "node scripts/migrate.js",
    "set-password": "node scripts/setPassword.js",
    "check-auth": "node scripts/checkAuth.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/*"
    ]
  }
}
